# Copy to .env and fill in what you need. `.env` is gitignored — keys never
# enter the repo. Which model key is required depends on who plays.

ANT_API_KEY=            # Anthropic; passed to each Claude session as ANTHROPIC_API_KEY
OPENAI_API_KEY=         # only to play with --agent codex
ARC_API_KEY=            # from three.arcprize.org — held by the broker, never by an agent
E2B_API_KEY=            # e2b.dev — the fenced sandboxes every game plays in
POSTGRES_DSN=           # a Neon database; the record every session mirrors itself to
